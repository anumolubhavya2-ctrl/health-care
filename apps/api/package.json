{
  "name": "@caresync/api",
  "version": "1.0.0",
  "private": true,
  "description": "CareSync API Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node ..\\..\\node_modules\\tsx\\dist\\cli.mjs watch src/server.ts",
    "build": "node ..\\..\\node_modules\\typescript\\bin\\tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:push": "node ..\\..\\node_modules\\prisma\\build\\index.js db push",
    "db:seed": "node ..\\..\\node_modules\\tsx\\dist\\cli.mjs prisma/seed.ts",
    "db:studio": "node ..\\..\\node_modules\\prisma\\build\\index.js studio",
    "db:generate": "node ..\\..\\node_modules\\prisma\\build\\index.js generate",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.4",
    "uuid": "^9.0.1",
    "winston": "^3.12.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.8",
    "prisma": "^5.10.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  }
}
